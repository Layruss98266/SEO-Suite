# Copy this file to .env and fill in your real values
# .env is git-ignored — never commit it

# ── Third-party SEO data APIs ────────────────────────────────────────────────
PAGESPEED_API_KEY=
SERPAPI_KEY=
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=
# DataForSEO is used by both phase4 (rankings/backlinks) and the new
# keyword_research tool. Login is your account email; password is the API key.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Email notifications (optional) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ── Webhook notifications (optional) ─────────────────────────────────────────
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ── AI assistance (optional — Stage 3-D) ─────────────────────────────────────
# Free tier: https://console.groq.com → API Keys
# Unlocks "Explain with AI" and "Draft Meta" features throughout the dashboard.
GROQ_API_KEY=

# ── Bing Webmaster (optional — Stage 3-A) ────────────────────────────────────
# Get key at: https://www.bing.com/webmasters → Settings → API Access
# Or set via Settings panel → bing_api_key
BING_WEBMASTER_API_KEY=

# ── Error tracking (optional) ────────────────────────────────────────────────
# Set SENTRY_DSN to activate Sentry error tracking. Leave blank to disable.
# Get your DSN at https://sentry.io/
SENTRY_DSN=
# "development" | "staging" | "production"
SEO_SUITE_ENV=development

# ── Server binding ───────────────────────────────────────────────────────────
# Default is 127.0.0.1 (loopback only). Set to 0.0.0.0 to expose on the LAN —
# only do this once you've put auth in front of the server.
SEO_SUITE_HOST=127.0.0.1
SEO_SUITE_PORT=8080

# ── Authentication (optional) ────────────────────────────────────────────────
# Set both to enable password-protected access.
# Generate hash: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
SEO_SUITE_USERNAME=admin
SEO_SUITE_PASSWORD_HASH=
# Set to 1 to force authentication strictly from first boot, even if no users exist yet
# (automatically set to true on Render to secure public deployments).
SEO_SUITE_FORCE_AUTH=

# ── Session security ─────────────────────────────────────────────────────────
# Random secret for Flask session signing. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SEO_SUITE_SECRET=
# Base URL of the deployment, used to construct fully-qualified password reset and verification links.
# e.g., https://seosuite.example.com
SEO_SUITE_BASE_URL=http://localhost:8080

# ── CORS (optional) ──────────────────────────────────────────────────────────
# Comma-separated allowed origins. Default: localhost:8080 only.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── PDF generation (optional) ────────────────────────────────────────────────
# Number of parallel workers for PDF export. Default: 2.
SEO_SUITE_PDF_WORKERS=2

# ── Persistence backend (optional) ───────────────────────────────────────────
# Users are stored in SQLite (data/seo_suite.db) by default. Set to "json"
# only for emergency rollback to the legacy users.json file backend.
SEO_SUITE_USERS_BACKEND=sqlite

# ── Logging format (optional) ────────────────────────────────────────────────
# Set to 1 to emit structured JSON logs (ELK/Datadog/Loki ingestion).
SEO_SUITE_LOG_JSON=
